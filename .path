# Homebrew (Apple Silicon): put brew + its bins on PATH.
# Needed for bash login shells; zsh gets this via ~/.zprofile.
eval "$(/opt/homebrew/bin/brew shellenv)"

ANDROID_HOME="$HOME/Library/Android/sdk"

export PATH=${PATH}:${ANDROID_HOME}/tools
export PATH=${PATH}:${ANDROID_HOME}/platform-tools
export PATH="/usr/local/sbin:$PATH"

export GOPATH=$HOME/golang
export GOROOT=/opt/homebrew/opt/go/libexec
export PATH=$PATH:$GOPATH/bin
export PATH=$PATH:$GOROOT/bin
[ -d "$HOME/Projects/prosperity/whisper.cpp/build/bin" ] && export PATH="$PATH:$HOME/Projects/prosperity/whisper.cpp/build/bin"
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
export PATH="/opt/homebrew/opt/postgresql@16/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"