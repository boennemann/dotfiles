#!/usr/bin/env bash

mkd() {
	if (($# != 1)); then
		echo "Usage: mkd DIRECTORY" >&2
		return 2
	fi
	mkdir -p -- "$1" || return
	cd -- "$1" || return
}

cdf() {
	local finder_path
	finder_path="$(osascript -e 'tell app "Finder" to POSIX path of (insertion location as alias)')" || return
	cd -- "${finder_path}" || return
}

targz() {
	if (($# != 1)); then
		echo "Usage: targz PATH" >&2
		return 2
	fi
	local source_path="${1%/}"
	local tar_path="${source_path}.tar"
	local size command_name zipped_size

	tar -cvf "${tar_path}" --exclude=".DS_Store" -- "${source_path}" || return
	if size="$(stat -f "%z" "${tar_path}" 2>/dev/null)"; then
		:
	else
		size="$(stat -c "%s" "${tar_path}")" || return
	fi

	if ((size < 52428800)) && command -v zopfli >/dev/null 2>&1; then
		command_name="zopfli"
	elif command -v pigz >/dev/null 2>&1; then
		command_name="pigz"
	else
		command_name="gzip"
	fi

	printf 'Compressing %s (%d kB) with %s…\n' "${tar_path}" "$((size / 1000))" "${command_name}"
	"${command_name}" -v "${tar_path}" || return
	if zipped_size="$(stat -f "%z" "${tar_path}.gz" 2>/dev/null)"; then
		:
	else
		zipped_size="$(stat -c "%s" "${tar_path}.gz")" || return
	fi
	printf '%s (%d kB) created successfully.\n' "${tar_path}.gz" "$((zipped_size / 1000))"
}

fs() {
	local arg="-sh"
	du -b /dev/null >/dev/null 2>&1 && arg="-sbh"
	if (($#)); then
		du "${arg}" -- "$@"
	else
		(
			shopt -s dotglob nullglob
			paths=(*)
			((${#paths[@]})) && du "${arg}" -- "${paths[@]}"
		)
	fi
}

dataurl() {
	if (($# != 1)); then
		echo "Usage: dataurl FILE" >&2
		return 2
	fi
	local mime_type
	mime_type="$(file -b --mime-type -- "$1")" || return
	[[ "${mime_type}" == text/* ]] && mime_type="${mime_type};charset=utf-8"
	printf 'data:%s;base64,' "${mime_type}"
	openssl base64 -A -in "$1"
	printf '\n'
}

server() {
	local port="${1:-8000}"
	(sleep 1 && open "http://localhost:${port}/") &
	python3 -m http.server "${port}"
}

gz() {
	if (($# != 1)); then
		echo "Usage: gz FILE" >&2
		return 2
	fi
	local original_size gzip_size ratio
	original_size="$(wc -c <"$1")" || return
	gzip_size="$(gzip -c -- "$1" | wc -c)" || return
	if ((original_size == 0)); then
		ratio="0.00"
	else
		ratio="$(awk -v compressed="${gzip_size}" -v original="${original_size}" 'BEGIN { printf "%.2f", compressed * 100 / original }')"
	fi
	printf 'orig: %d bytes\ngzip: %d bytes (%s%%)\n' "${original_size}" "${gzip_size}" "${ratio}"
}

digga() {
	if (($# != 1)); then
		echo "Usage: digga DOMAIN" >&2
		return 2
	fi
	dig +nocmd "$1" any +multiline +noall +answer
}

getcertnames() {
	if (($# != 1)); then
		echo "Usage: getcertnames DOMAIN" >&2
		return 2
	fi
	openssl s_client -connect "$1:443" -servername "$1" </dev/null 2>/dev/null |
		openssl x509 -noout -subject -ext subjectAltName
}

urlencode() {
	if (($# != 1)); then
		echo "Usage: urlencode STRING" >&2
		return 2
	fi
	python3 -c 'import sys, urllib.parse; print(urllib.parse.quote_plus(sys.argv[1]))' "$1"
}

ifactive() {
	local interface
	for interface in $(ifconfig -l); do
		if ifconfig "${interface}" | grep -q "status: active"; then
			printf '%s\n' "${interface}"
		fi
	done
}

path() {
	printf '%s\n' "${PATH//:/$'\n'}"
}

if [[ "$(uname -s)" != "Darwin" ]]; then
	if grep -q Microsoft /proc/version 2>/dev/null; then
		alias open="explorer.exe"
	else
		alias open="xdg-open"
	fi
fi

o() {
	if (($# == 0)); then
		open .
	else
		open "$@"
	fi
}
