#!/usr/bin/env bash

set -euo pipefail

dry_run=false
assume_yes=false

usage() {
	cat <<'EOF'
Usage: ./.macos [--dry-run] [--yes]

Apply a small set of macOS 26 user-interface defaults.
EOF
}

while (($#)); do
	case "$1" in
	--dry-run) dry_run=true ;;
	--yes) assume_yes=true ;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		echo "ERROR: Unknown option: $1" >&2
		usage >&2
		exit 2
		;;
	esac
	shift
done

if [[ "$(uname -s)" != "Darwin" ]]; then
	echo "ERROR: This script supports macOS only." >&2
	exit 1
fi

macos_major="$(sw_vers -productVersion | cut -d. -f1)"
if ((macos_major < 26)); then
	echo "ERROR: These defaults are maintained for macOS 26 or newer." >&2
	exit 1
fi

run() {
	printf '+'
	printf ' %q' "$@"
	printf '\n'
	if [[ "${dry_run}" == false ]]; then
		"$@"
	fi
}

if [[ "${dry_run}" == false && "${assume_yes}" == false ]]; then
	if [[ ! -t 0 ]]; then
		echo "ERROR: Non-interactive application requires --yes." >&2
		exit 2
	fi
	read -r -p "Apply the documented macOS defaults? [y/N] " reply
	if [[ ! "${reply}" =~ ^[Yy]$ ]]; then
		echo "Cancelled."
		exit 0
	fi
fi

# Keyboard
run defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false
run defaults write NSGlobalDomain KeyRepeat -int 1
run defaults write NSGlobalDomain InitialKeyRepeat -int 10

# Finder
run defaults write NSGlobalDomain AppleShowAllExtensions -bool true
run defaults write com.apple.finder ShowStatusBar -bool true
run defaults write com.apple.finder ShowPathbar -bool true
run defaults write com.apple.finder _FXSortFoldersFirst -bool true
run defaults write com.apple.finder FXPreferredViewStyle -string Nlsv
run defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
run defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true

# Dock
run defaults write com.apple.dock autohide -bool true
run defaults write com.apple.dock autohide-delay -float 0
run defaults write com.apple.dock show-recents -bool false
run defaults write com.apple.dock tilesize -int 41

# Screenshots
run mkdir -p -- "${HOME}/Documents"
run defaults write com.apple.screencapture location -string "${HOME}/Documents"
run defaults write com.apple.screencapture type -string png
run defaults write com.apple.screencapture disable-shadow -bool true

# Require a password immediately after sleep or the screen saver starts.
run defaults write com.apple.screensaver askForPassword -int 1
run defaults write com.apple.screensaver askForPasswordDelay -int 0

if [[ "${dry_run}" == false ]]; then
	preference_checks=(
		"NSGlobalDomain ApplePressAndHoldEnabled"
		"NSGlobalDomain KeyRepeat"
		"NSGlobalDomain InitialKeyRepeat"
		"NSGlobalDomain AppleShowAllExtensions"
		"com.apple.finder ShowStatusBar"
		"com.apple.finder ShowPathbar"
		"com.apple.finder _FXSortFoldersFirst"
		"com.apple.finder FXPreferredViewStyle"
		"com.apple.desktopservices DSDontWriteNetworkStores"
		"com.apple.desktopservices DSDontWriteUSBStores"
		"com.apple.dock autohide"
		"com.apple.dock autohide-delay"
		"com.apple.dock show-recents"
		"com.apple.dock tilesize"
		"com.apple.screencapture location"
		"com.apple.screencapture type"
		"com.apple.screencapture disable-shadow"
		"com.apple.screensaver askForPassword"
		"com.apple.screensaver askForPasswordDelay"
	)
	for preference in "${preference_checks[@]}"; do
		domain="${preference%% *}"
		key="${preference#* }"
		defaults read "${domain}" "${key}" >/dev/null
	done
	unset preference preference_checks domain key

	for app in Finder Dock SystemUIServer; do
		killall "${app}" >/dev/null 2>&1 || true
	done
	echo "macOS defaults applied. Some changes may require signing out."
else
	echo "Dry run complete; no defaults were changed."
fi
