# Shell - use bash (matching iTerm2 config)
command = /opt/homebrew/bin/bash

# Font - JetBrains Mono 13 (matching iTerm2)
font-family = JetBrains Mono
font-size = 13

# Color scheme - Solarized Dark
theme = iTerm2 Solarized Dark

# Scrollback - large buffer (iTerm2 had unlimited)
scrollback-limit = 10000000

# Option key sends normal characters (matching iTerm2)
macos-option-as-alt = false

# Window management
window-padding-x = 4
window-padding-y = 4
window-decoration = true

# Cursor
cursor-style = block
cursor-style-blink = false

# Copy behavior
copy-on-select = clipboard
clipboard-paste-protection = true

# Shell integration
shell-integration = bash

# Don't confirm before closing a tab/window with running processes
confirm-close-surface = false
